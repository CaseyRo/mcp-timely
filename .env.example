# Timely OAuth application — create one at https://app.timelyapp.com/<account>/oauth_applications
# with callback URL: urn:ietf:wg:oauth:2.0:oob
TIMELY_CLIENT_ID=
TIMELY_CLIENT_SECRET=

# Where the token pair is persisted. Timely rotates refresh tokens on every
# refresh, so this file must be writable and persistent (a volume in Docker).
TIMELY_TOKEN_FILE=timely_tokens.json

# Server transport: stdio (default) or http (streamable-http on /mcp)
TRANSPORT=stdio
HOST=127.0.0.1
PORT=8000

# Bearer token protecting the MCP endpoint — required when TRANSPORT=http
MCP_API_KEY=
